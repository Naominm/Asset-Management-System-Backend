# Copy this file to .env and fill in the values. Never commit .env itself.

# ─── Database ────────────────────────────────────────────────────────────────
# Local PostgreSQL, or the connection string your host gives you.
# On Render, use the Internal Database URL for a service in the same region
# and the External Database URL from anywhere else (append ?sslmode=require).
DATABASE_URL=postgresql://postgres:password@localhost:5432/ictams?sslmode=disable

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000

# Browser origins allowed by CORS, comma separated, no spaces. Private network
# addresses (10.x, 172.16-31.x, 192.168.x) are accepted automatically, so an
# office server whose address changes does not need to be listed here.
FRONTEND_URL=http://localhost:3000

# Signs login tokens. Use a long random string, different per environment.
# Generate one with: openssl rand -base64 48
JWT_SECRET=

# ─── First administrator ─────────────────────────────────────────────────────
# Created by `npm run seed`. `npm run seed -- --reset-password` sets this
# account's password back to INITIAL_ADMIN_PASSWORD and reactivates it.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_FULL_NAME=System Administrator
INITIAL_ADMIN_STAFF_NO=ICT-ADMIN-001
INITIAL_ADMIN_JOB_TITLE=ICT Administrator

# ─── Email (Brevo) ───────────────────────────────────────────────────────────
# The sending address must be verified in Brevo, and the server's public IP
# must be listed at https://app.brevo.com/security/authorised_ips or Brevo
# rejects the request with "unrecognised IP address".
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=SDJHRCA ICT Department
EMAIL_USER=

# Writes emails to the log instead of sending them. For local development
# only — setting this on a server stops every notification silently.
# EMAIL_DEV_LOG_ONLY=true
